PORT=4000
# Bind address: use 0.0.0.0 so phones/Expo on LAN can reach the API (default in code).
# LISTEN_HOST=127.0.0.1
# Local: use host port published by Docker (see docker-compose.yml)
MONGODB_URI=mongodb://127.0.0.1:27017/kivoni
# From another container on the same Compose network, use: mongodb://mongo:27017/kivoni
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES=15m
# Customer-facing auth (magic link login, Loop 7) — deliberately a separate secret from staff's
# JWT_ACCESS_SECRET so a customer token can never be mistaken for a staff token.
JWT_CUSTOMER_ACCESS_SECRET=change-me-customer-access-secret-min-32-chars!!
JWT_CUSTOMER_ACCESS_EXPIRES=30m
SEED_ADMIN_EMAIL=admin@kivoni.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to true or 1 to insert idempotent demo customers/suppliers/orders (see src/seed/lmfit-demo.fixtures.ts)
# SEED_DEMO_DATA=true
WEB_ORIGIN=http://localhost:3000
# Optional extra CORS origins (comma-separated), e.g. Expo web or another dev port
# WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:3000

# --- Meta WhatsApp Cloud API (see docs/whatsapp-meta-gemini-spec.md) ---
# META_APP_SECRET=
# META_WHATSAPP_VERIFY_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=v21.0

# --- LLM (open-weight models via OpenAI-compatible API: groq | together | deepinfra | openrouter) ---
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# Only needed to override the provider's default base URL
# LLM_BASE_URL=
# PUBLIC_API_BASE_URL=https://api.example.com
# WEB_ADMIN_BASE_URL=http://localhost:3000
# STAFF_NOTIFY_EMAILS=ops@example.com
# STAFF_NOTIFY_WHATSAPP_TEMPLATE_NAME=
# STAFF_NOTIFY_WHATSAPP_TEMPLATE_LANG=pt_BR
# STAFF_NOTIFY_WHATSAPP_NUMBERS=5511999999999
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# WHATSAPP_REQUIRE_ALLOWLIST=true

# --- Checkout / PIX / webhooks (lmfit-web e-commerce) ---
# WEBHOOK_URL=https://your-app.example.com/api/inbound/payments
# WEBHOOK_SECRET=optional-hmac-secret
# PIX_PROVIDER=dev
# PIX_EXPIRES_MINUTES=30
# Optional data-URL or HTTPS image for QR in dev
# PIX_DEV_QR_IMAGE=
# PAYMENT_DEV_CONFIRM_KEY=change-me-to-call-POST-/public/payments/:id/dev-confirm
# Segredo embutido na query do webhook_url que geramos para a InfinitePay (não confundir com
# WEBHOOK_SECRET acima, que é para nossos webhooks de saída). Sem isso, /public/payments/infinitepay-webhook
# rejeita toda chamada — obrigatório antes de configurar InfinitePay real em um tenant.
# PAYMENT_WEBHOOK_SECRET=change-me-long-random-string

# Respostas JSON: valores monetários como string pt-BR (ex. "1.234,56"). Desligue se o cliente precisar de number.
# BRL_DISABLE_MONETARY_RESPONSE_FORMAT=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
# Sentry DSN for error tracking. Leave empty to disable (safe no-op locally).
# SENTRY_DSN=

# --- Credential encryption (Loop 18) ---
# Used by EncryptionService (AES-256-GCM) to encrypt server-side tokens stored on Tenant/
# Integration docs (analytics tokens today; other credentials are a documented follow-up).
# Any string works — a 32-byte key is derived via scrypt. Without it, encrypt() throws but
# decrypt() still passes through any already-existing plaintext value unchanged.
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Loop 26: canário do caminho do dinheiro ---
# Slug de um tenant DEDICADO só pro pedido sintético diário (nunca reusar um tenant real — ver
# docs/ecommerce/specs/loop-26-money-path-canary.md). Sem isso o cron é no-op.
# CANARY_TENANT_SLUG=
# SKU da variante usada no pedido sintético, dentro do tenant acima.
# CANARY_VARIANT_SKU=
# Quantos dias manter os pedidos do tenant de canário antes de podar.
# CANARY_RETENTION_DAYS=7
# Janela de dedup do alerta de falha real do checkout público — evita que uma quebra geral
# vire uma enxurrada de e-mails; o Sentry recebe todas as ocorrências de qualquer forma.
# CHECKOUT_ALERT_DEDUP_MINUTES=60
