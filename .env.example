PORT=4000
# Bind address: use 0.0.0.0 so phones/Expo on LAN can reach the API (default in code).
# LISTEN_HOST=127.0.0.1
# Local: use host port published by Docker (see docker-compose.yml)
MONGODB_URI=mongodb://127.0.0.1:27017/lmfit
# From another container on the same Compose network, use: mongodb://mongo:27017/lmfit
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES=15m
SEED_ADMIN_EMAIL=admin@lmfit.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to true or 1 to insert idempotent demo customers/suppliers/orders (see src/seed/lmfit-demo.fixtures.ts)
# SEED_DEMO_DATA=true
WEB_ORIGIN=http://localhost:3000
# Optional extra CORS origins (comma-separated), e.g. Expo web or another dev port
# WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:3000

# --- Meta WhatsApp Cloud API + Gemini (see docs/whatsapp-meta-gemini-spec.md) ---
# META_APP_SECRET=
# META_WHATSAPP_VERIFY_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=v21.0
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# PUBLIC_API_BASE_URL=https://api.example.com
# WEB_ADMIN_BASE_URL=http://localhost:3000
# STAFF_NOTIFY_EMAILS=ops@example.com
# STAFF_NOTIFY_WHATSAPP_TEMPLATE_NAME=
# STAFF_NOTIFY_WHATSAPP_TEMPLATE_LANG=pt_BR
# STAFF_NOTIFY_WHATSAPP_NUMBERS=5511999999999
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# WHATSAPP_REQUIRE_ALLOWLIST=true

# --- Checkout / PIX / webhooks (lmfit-web e-commerce) ---
# WEBHOOK_URL=https://your-app.example.com/api/inbound/payments
# WEBHOOK_SECRET=optional-hmac-secret
# PIX_PROVIDER=dev
# PIX_EXPIRES_MINUTES=30
# Optional data-URL or HTTPS image for QR in dev
# PIX_DEV_QR_IMAGE=
# PAYMENT_DEV_CONFIRM_KEY=change-me-to-call-POST-/public/payments/:id/dev-confirm

# Respostas JSON: valores monetários como string pt-BR (ex. "1.234,56"). Desligue se o cliente precisar de number.
# BRL_DISABLE_MONETARY_RESPONSE_FORMAT=1
