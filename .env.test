# Loop 26 — segredos dummy só para `npm run test:e2e`. MONGODB_URI é sobrescrita em tempo de
# execução pelo mongodb-memory-server (test/globalSetup.js); o valor abaixo nunca é usado de
# verdade, existe só como fallback caso alguém rode um teste isolado sem o helper.
NODE_ENV=test
MONGODB_URI=mongodb://127.0.0.1:27017/kivoni-test
JWT_ACCESS_SECRET=e2e-dummy-access-secret-min-32-chars!!
JWT_CUSTOMER_ACCESS_SECRET=e2e-dummy-customer-secret-min-32-chars!!
WEB_ORIGIN=http://localhost:3000
CREDENTIALS_ENCRYPTION_KEY=e2e-dummy-encryption-key
SEED_ADMIN_EMAIL=e2e-admin@kivoni.local
SEED_ADMIN_PASSWORD=E2eChangeMe123!

# Achado durante o IMPLEMENT (13/08/2026): ConfigModule.forRoot() carrega o .env real da máquina
# de quem roda o teste por baixo dos panos, preenchendo qualquer chave que este arquivo não define
# — sem os overrides abaixo, um .env de dev comum (SEED_DEMO_DATA=true, SMTP_HOST real, SENTRY_DSN
# real) vazava pro e2e: chegou a tentar semear dados de demonstração (e quebrar num bug pré-existente
# e não relacionado — status 'received' não bate com o enum do schema Purchase) e teria mandado
# e-mail de verdade pro suporte + reportado erro de teste no Sentry de produção se o fluxo tivesse
# ido adiante. O e2e precisa ser hermético: nunca pode depender de nem vazar pro ambiente de quem
# roda. Toda chave abaixo é um "nunca dispare isso de verdade durante o teste", não um placeholder.
SEED_DEMO_DATA=false
LLM_PROVIDER=
LLM_API_KEY=
SMTP_HOST=
STAFF_NOTIFY_EMAILS=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_URL=
WEBHOOK_URL=
PAYMENT_WEBHOOK_SECRET=
